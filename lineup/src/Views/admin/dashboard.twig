{% set page_id = 'dashboard' %}
{% extends 'base.twig' %}
{% block title %}Admin Dashboard{% endblock %}
{% block content %}    
<link href="/assets/dashboard.css" rel="stylesheet">
<div class="container-fluid">
  <div class="row">
    <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
      <div class="position-sticky pt-3">
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="#">
              <span data-feather="home"></span>
              Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#">
              <span data-feather="file"></span>
              Barbers
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#">
              <span data-feather="shopping-cart"></span>
              Appointments
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/services">
              <span data-feather="users"></span>
              Services
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
      </div>
      <h2>Barbers</h2>
      <div class="table-responsive">
        <table class="table table-striped table-sm">
          <thead>
            <tr>
              <th scope="col">First Name</th>
              <th scope="col">Last Name</th>
              <th scope="col">Bio</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for barber in barbers %}
            <tr>
              <td>{{ barber.firstName }}</td>
              <td>{{ barber.lastName }}</td>
              <td>{{ barber.bio }}</td>
              <td>
                <a href="/admin/dashboard/barbers/edit/{{ barber.id }}" class="btn btn-sm btn-outline-secondary">Edit</a>
                <form action="/admin/dashboard/barbers/delete/{{ barber.id }}" method="post" style="display:inline">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <h2>Appointments</h2>
      <div class="tab-content table-responsive">
        <table class="table table-striped table-sm">
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Time</th>
              <th scope="col">Status</th>
              <th scope="col">Update Status</th>
            </tr>
          </thead>
          <tbody>
            {% for appointment in appointments %}
            <tr>
              <td>{{ appointment.date }}</td>
              <td>{{ appointment.time }}</td>
              <td>{{ appointment.status }}</td>
              <td>
                <form action="/admin/dashboard/appointment/status/{{ appointment.id }}" method="post" style="display:inline">
                  <select name="status" class="form-select form-select-sm d-inline w-auto" {% if appointment.status == 'completed' %}disabled{% endif %}>
                    <option value="pending" {% if appointment.status == 'pending' %}selected{% endif %}>Pending</option>
                    <option value="confirmed" {% if appointment.status == 'confirmed' %}selected{% endif %}>Confirmed</option>
                    <option value="completed" {% if appointment.status == 'completed' %}selected{% endif %}>Completed</option>
                    <option value="cancelled" {% if appointment.status == 'cancelled' %}selected{% endif %}>Cancelled</option>
                  </select>
                  {% if appointment.status != 'completed' %}
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Update</button>
                  {% endif %}
                </form>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </main>
</div>
{% endblock %}
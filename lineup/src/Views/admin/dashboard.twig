{% set page_id = 'dashboard' %}
{% extends 'base.twig' %}
{% block title %}{{ 'admin.dashboard.title'|trans }}{% endblock %}
{% block content %}    
<link href="/assets/dashboard.css" rel="stylesheet">
<div class="container-fluid">
  <div class="row">
    <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
      <div class="position-sticky pt-3">
        <ul class="nav flex-column">
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="#">
              <span data-feather="home"></span>
              {{ 'admin.dashboard.sidebar_dashboard'|trans }}
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#">
              <span data-feather="file"></span>
              {{ 'admin.dashboard.sidebar_barbers'|trans }}
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="#">
              <span data-feather="shopping-cart"></span>
              {{ 'admin.dashboard.sidebar_appointments'|trans }}
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/services">
              <span data-feather="users"></span>
              {{ 'admin.dashboard.sidebar_services'|trans }}
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
      {% block flash %}
      {% if flash is defined and flash %}
      <div class="mt-3" id="flash-container">
        <div class="alert alert-{{ flash.type == 'error' ? 'danger' : 'success' }} alert-dismissible fade show" role="alert">
          {{ flash.message }}
          <button type="button" class="btn-close" onclick="this.closest('#flash-container').remove()" aria-label="Close"></button>
        </div>
      </div>
      {% endif %}
      {% endblock %}
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
      </div>
      <h2>{{ 'admin.dashboard.barbers_heading'|trans }}</h2>
      <div class="table-responsive">
        <table class="table table-striped table-sm">
          <thead>
            <tr>
              <th scope="col">Photo</th>
              <th scope="col">{{ 'admin.dashboard.first_name'|trans }}</th>
              <th scope="col">{{ 'admin.dashboard.last_name'|trans }}</th>
              <th scope="col">{{ 'admin.dashboard.bio'|trans }}</th>
              <th scope="col">{{ 'admin.dashboard.actions'|trans }}</th>
            </tr>
          </thead>
          <tbody>
            {% for barber in barbers %}
            <tr>
              <td>
                <img src="/uploads/barbers/{{ barber.photo ?: 'placeholder.jpg' }}" alt="{{ barber.firstName }}" style="width:50px;height:50px;object-fit:cover;border-radius:4px;">
              </td>
              <td>{{ barber.firstName }}</td>
              <td>{{ barber.lastName }}</td>
              <td>{{ barber.bio }}</td>
              <td>
                <a href="/admin/dashboard/barbers/edit/{{ barber.id }}" class="btn btn-sm btn-outline-secondary">{{ 'admin.dashboard.edit'|trans }}</a>
                <form action="/admin/dashboard/barbers/delete/{{ barber.id }}" method="post" style="display:inline">
                <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'admin.dashboard.delete'|trans }}</button>
                </form>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <h2>{{ 'admin.dashboard.appointments_heading'|trans }}</h2>
      <div class="tab-content table-responsive">
        <table class="table table-striped table-sm">
          <thead>
            <tr>
              <th scope="col">{{ 'admin.dashboard.date'|trans }}</th>
              <th scope="col">{{ 'admin.dashboard.time'|trans }}</th>
              <th scope="col">{{ 'admin.dashboard.status'|trans }}</th>
              <th scope="col">{{ 'admin.dashboard.update_status'|trans }}</th>
            </tr>
          </thead>
          <tbody>
            {% for appointment in appointments %}
            <tr>
              <td>{{ appointment.date }}</td>
              <td>{{ appointment.time }}</td>
              <td>{{ ('admin.dashboard.' ~ appointment.status)|trans }}</td>
              <td>
                <form action="/admin/dashboard/appointment/status/{{ appointment.id }}" method="post" style="display:inline">
                  <select name="status" class="form-select form-select-sm d-inline w-auto" {% if appointment.status == 'completed' %}disabled{% endif %}>
                    <option value="pending" {% if appointment.status == 'pending' %}selected{% endif %}>{{ 'admin.dashboard.pending'|trans }}</option>
                    <option value="confirmed" {% if appointment.status == 'confirmed' %}selected{% endif %}>{{ 'admin.dashboard.confirmed'|trans }}</option>
                    <option value="completed" {% if appointment.status == 'completed' %}selected{% endif %}>{{ 'admin.dashboard.completed'|trans }}</option>
                    <option value="cancelled" {% if appointment.status == 'cancelled' %}selected{% endif %}>{{ 'admin.dashboard.cancelled'|trans }}</option>
                  </select>
                  {% if appointment.status != 'completed' %}
                    <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'admin.dashboard.update'|trans }}</button>
                  {% endif %}
                </form>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </main>
</div>
{% endblock %}
{% extends 'base.twig' %}
{% block title %}Edit Barber{% endblock %}
{% block content %}
<div class="services-page">
  <section class="py-5 text-center container">
    <div class="row py-lg-5">
      <div class="col-lg-6 col-md-8 mx-auto">
        <h1 class="fw-bold">Edit Barber</h1>
      </div>
    </div>
  </section>
  <div class="album py-5 bg-light">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow-sm">
            <div class="card-body">
              <form action="/admin/barbers/edit/{{ barber.id }}" method="post">
                <div class="mb-3">
                  <label class="form-label">Barber First Name</label>
                  <input type="text" name="firstName" class="form-control" value="{{ barber.firstName }}" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">Barber Last Name</label>
                  <input type="text" name="lastName" class="form-control" value="{{ barber.lastName }}" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">Description</label>
                  <textarea name="bio" class="form-control" rows="3" required>{{ barber.bio }}</textarea>
                </div>
                <div class="d-flex justify-content-between">
                  <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
                  <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
{% extends 'base.twig' %}
{% block title %}{{ 'auth.2fa.title'|trans }}{% endblock %}
{% block content %}
<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body text-center">
                    <h3 class="card-title mb-3">{{ 'auth.2fa.verify_heading'|trans }}</h3>
                    <p class="text-muted">{{ 'auth.2fa.verify_info'|trans }}</p>

                    <form action="/auth/2fa/verify" method="post">
                        <div class="form-group mb-3">
                            <input id="code" name="code" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="{{ 'auth.2fa.code_placeholder'|trans }}" required autofocus class="form-control form-control-lg text-center">
                        </div>
                        <button type="submit" class="btn btn-primary btn-block w-100">{{ 'auth.2fa.verify'|trans }}</button>
                    </form>

                    <div class="mt-3">
                        <a href="/logout">{{ 'nav.logout'|trans }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

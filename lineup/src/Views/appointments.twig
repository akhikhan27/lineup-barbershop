{% extends 'base.twig' %}
{% block title %}{{ 'appointments.title'|trans }}{% endblock %}
{% block content %}
<div class="services-page">
  <section class="py-5 text-center container">
    <div class="row py-lg-5">
      <div class="col-lg-6 col-md-8 mx-auto">
        <h1 class="fw-bold">{{ 'appointments.heading'|trans }}</h1>
      </div>
    </div>
  </section>
  <div class="album py-5 bg-light">
    <div class="container">
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3">
        {% for appointment in appointments %}
        <div class="col">
          <div class="card shadow-sm">
          <img src=https://images.unsplash.com/photo-1621605815971-fbc98d665033?q=80&w=2670&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D class="card-img-top" alt="{{ service.name}}">
            <div class="card-body">
            <h5 class = "card-title"> {{ appointment.service_name }} </h5>
              <p class="card-text">{{ appointment.date }} at {{ appointment.time }}</p>
              <p class="card-text"><strong>{{ 'appointments.status_label'|trans }}</strong> {{ appointment.status }}</p>
              <div class="d-flex justify-content-between align-items-center">
                <div class="btn-group">
                  {% if appointment.status == 'completed' and appointment.review_id is null %}
                    <a href="/reviews/{{ appointment.id }}" class="btn btn-sm btn-outline-success">{{ 'appointments.leave_review'|trans }}</a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
        {% else %}
            <div class="col text-center">
                <p class="text-muted">{{ 'appointments.empty'|trans }}
                <a href="/services" class="btn btn-outline-secondary">{{ 'appointments.browse_services'|trans }}</a>
            </div>
        {% endfor %}
      </div>
      <div class="col text-center">
        <a href="/services" class="btn btn-outline-secondary">{{ 'appointments.explore_services'|trans }}</a>
      </div>
    </div>
  </div>
  </div>
{% endblock %}
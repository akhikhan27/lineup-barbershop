<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Lineup{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/assets/styles.css">
    <link rel="stylesheet" href="/assets/home-styles.css">
    <link rel="canonical" href="https://getbootstrap.com/docs/5.0/examples/album/">
    <link href="https://fonts.googleapis.com/css?family=Varela+Round" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
<!-- Navigation-->
        <nav class="navbar navbar-expand-lg navbar-light fixed-top
        
        {{ page_id == 'dashboard' ? 'navbar-dark bg-dark' : 'navbar-light' }}" id="mainNav">
            <div class="container px-4 px-lg-5">
                <a class="navbar-brand" href="/">{{ 'nav.home'|trans }}</a>
                <button class="navbar-toggler navbar-toggler-right" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="{{ 'nav.menu'|trans }}">
                    {{ 'nav.menu'|trans }}
                    <i class="fas fa-bars"></i>
                </button>
                <div class="collapse navbar-collapse" id="navbarResponsive">
                    <ul class="navbar-nav ms-auto">
                        {% block navlinks %}
                        {% if session.user is defined and session.user.role == 'customer' %}
                            <li class="nav-item"><a class="nav-link" href="/appointments">{{ 'nav.appointments'|trans }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="/logout">{{ 'nav.logout'|trans }}</a></li>
                        {% elseif session.user is defined and session.user.role == 'admin' %}
                            <li class="nav-item"><a class="nav-link" href="/logout">{{ 'nav.logout'|trans }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="/admin/dashboard">{{ 'nav.dashboard'|trans }}</a></li>
                        {% else %}
                            <li class="nav-item"><a class="nav-link" href="/login">{{ 'nav.login'|trans }}</a></li>
                            <li class="nav-item"><a class="nav-link" href="/register">{{ 'nav.signup'|trans }}</a></li>
                        {% endif %}
                            <li class="nav-item">
                                <a class="nav-link" href="?lang={{ current_locale == 'fr' ? 'en' : 'fr' }}">
                                    {{ current_locale == 'fr' ? 'EN' : 'FR' }}
                                </a>
                            </li>
                        {% endblock %}
                    </ul>
                </div>
            </div>
        </nav>

    {% if flash is defined and flash %}
    <div class="container mt-5 pt-5" id="flash-container">
        <div class="alert alert-{{ flash.type == 'error' ? 'danger' : 'success' }} alert-dismissible fade show" role="alert">
            {{ flash.message }}
            <button type="button" class="btn-close" onclick="this.closest('#flash-container').remove()" aria-label="Close"></button>
        </div>
    </div>
    {% endif %}

    {% block content %}{% endblock %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/scripts/navbar-script.js"></script>
</body>
</html>